# Copy to .env (never commit .env). Real secrets live ONLY in the real .env / your host's secret store.
APP_ENV=dev                      # dev | prod   (prod refuses to start on an unsafe configuration)
# SQLite is enough on a laptop. Production: postgresql+psycopg://USER:PASSWORD@HOST:5432/harako
DATABASE_URL=sqlite:///./harako.db
# Browser origins allowed to call the API. Capacitor Android WebView: https://localhost
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Placeholder records (source "seed-sample"). Must be false in production.
EXPOSE_SAMPLE_DATA=true

# --- Neshan SERVICE key (server only; NOT the browser map key). Empty = routing off.
NESHAN_SERVICE_KEY=
NESHAN_TIMEOUT_S=8

# --- Rate limiting / proxies
ROUTE_REQUESTS_PER_MINUTE=20
GEO_REQUESTS_PER_MINUTE=30
TOOLS_PAID_REQUESTS_PER_MINUTE=60
# Shared counters for several workers (recommended in production), e.g. redis://redis:6379/0
REDIS_URL=
# How many reverse proxies sit in front and append to X-Forwarded-For (0 = ignore the header)
TRUSTED_PROXY_COUNT=0
WEB_CONCURRENCY=1

# --- Admin panel /admin. Off until valid. Production: use the HASH (python -m app.admin_auth)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_SECRET_KEY=
# ADMIN_COOKIE_SECURE=            # default: true in prod, false otherwise
ADMIN_SESSION_MAX_AGE_S=28800
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_S=600
# ADMIN_ALLOWED_ORIGINS=admin.example.com   # only if a proxy rewrites the Host header

# --- AI assistant tool endpoints (/v1/tools/*)
TOOLS_ENABLED=true
TOOLS_API_KEY=
